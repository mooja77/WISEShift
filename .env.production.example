# ─── WISEShift Production Environment Variables ───
# Copy this to .env and fill in all values before deploying.

# Required
NODE_ENV="production"
DATABASE_URL="postgresql://user:password@host:5432/wiseshift"
PORT=3001

# Required in production (app will not start without these)
JWT_SECRET=""          # Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=""        # Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Frontend URL (for CORS)
FRONTEND_URL="https://yourdomain.com"

# Allowed origins for CORS/CSRF (comma-separated)
ALLOWED_ORIGINS="https://yourdomain.com"

# Auto-set by Railway (no need to configure manually)
# RAILWAY_PUBLIC_DOMAIN=your-app.up.railway.app

# Optional: AI-assisted coding
# AI_CODING_ENABLED="true"
# AI_PROVIDER="openai"      # openai | anthropic
# AI_API_KEY=""
# AI_MODEL=""

# Optional: Logging
# LOG_LEVEL="info"           # debug | info | warn | error
