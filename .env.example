# ─── WISEShift Development Environment Variables ───
# Copy this to .env to get started.
# Requires PostgreSQL (local install or Docker).
# Quick start: docker run -d --name wiseshift-pg -e POSTGRES_USER=wiseshift -e POSTGRES_PASSWORD=wiseshift -e POSTGRES_DB=wiseshift -p 5435:5432 postgres:15-alpine

DATABASE_URL="postgresql://wiseshift:wiseshift@localhost:5435/wiseshift"
PORT=3006
FRONTEND_URL="http://localhost:5173"
NODE_ENV="development"

# JWT secret for researcher tokens (required for researcher portal features)
JWT_SECRET="dev-jwt-secret-change-in-production"

# Admin secret for bulk import and ethics oversight endpoints
ADMIN_SECRET="dev-admin-secret-change-in-production"

# Optional: AI-assisted coding
# AI_CODING_ENABLED="true"
# AI_PROVIDER="openai"      # openai | anthropic
# AI_API_KEY=""
# AI_MODEL=""

# Optional: Logging level
# LOG_LEVEL="debug"          # debug | info | warn | error
